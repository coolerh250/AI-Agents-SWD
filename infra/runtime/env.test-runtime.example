# AT-M3.6B.2 readiness -- internal test-runtime env template.
#
# Copy to a gitignored env file the operator owns; never commit a filled-in copy.
# Validate with:
#
#     python scripts/validate_runtime_config.py --mode test-runtime --env-file <your file>
#
# THIS FILE CONTAINS NO SECRET AND MUST NEVER CONTAIN ONE. Two values are deliberately left as the
# placeholder sentinel: the runtime Vault token, which the operator mints during bootstrap, and
# nothing else. The Anthropic API key is NOT here at all and must not be added -- it lives in
# Vault, and an env-borne copy would survive in shell history, `docker inspect` output and process
# listings, which is exactly what routing it through Vault is meant to avoid.

APP_ENV=test-runtime

# --- secret rail -------------------------------------------------------------------------------
# Load-bearing. `provider_from_env` falls back to EnvSecretProvider for any unrecognised value and
# never raises, so a typo here would produce a runtime that looks configured and silently reads
# os.environ. The `test-runtime` validator mode asserts this literal value.
SECRET_PROVIDER=vault

# The internal compose-network address. Vault is not published to any interface a third party can
# reach; the host publishes it on loopback only, for the operator's own shell.
VAULT_ADDR=http://vault:8200

# The RUNTIME token: read-only, scoped by infra/vault/policies/aiagents-runtime-read.hcl to the one
# secret below. NEVER the root or operator token -- those are for manual administration and are
# never injected into a service. Replace with the real scoped token in your own gitignored copy.
VAULT_TOKEN=PLACEHOLDER_DO_NOT_COMMIT_REAL_VALUE

VAULT_KV_MOUNT=secret
# NOT `aiagents/staging`, which is the SecretProvider's built-in default and names an environment
# decommissioned at Step 66A.0. Leaving this unset lands on that default silently.
VAULT_KV_PATH=aiagents/test-runtime

# --- reasoning rail ----------------------------------------------------------------------------
# Configured for Anthropic, and NOT permitted to call it. Two separate facts on purpose: naming a
# provider is not permission to use it, and /operations/safety reports them separately so an
# operator can see the intended rail while the gate is shut.
REASONING_PROVIDER=anthropic
REASONING_MODEL=claude-sonnet-5

# THE GATE. False, and it stays false for the whole of this readiness slice. Opening it is
# AT-M3.6B.2 Live Validation, a Product Owner decision that has not been made. The validator FAILS
# if this reads true.
REASONING_LIVE_NETWORK_ENABLED=false
